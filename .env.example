# ==============================================================================
# SportsAgentic Configuration
# ==============================================================================
# Copy this file to .env before starting:
#   cp .env.example .env
#
# 1. CollegeFootballData API Key (Required)
#    Get your free key at: https://collegefootballdata.com/key
CFBD_API_KEY=your_cfbd_api_key_here

# 2. Server Port (Optional, defaults to 8080)
PORT=8080
